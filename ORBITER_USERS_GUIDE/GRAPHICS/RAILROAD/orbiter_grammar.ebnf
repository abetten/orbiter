Grammar  ::= Program
Program ::= ( Setup )*  CommandSequence
Setup ::= Verbosity | ListArgs | ParseOnly | SeedRandomGen | MemoryDebug | OverridePoly | OrbiterPath | MagmaPath | Fork
CommandSequence   ::= ( Command )*
Command ::= Definition | Assignment | Activity | GlobalCmd
Definition ::= '-define' Literal ObjectTypeAndArgs '-end' 
Assignment ::= '-assign' Literal ( '-and' Literal )* '-from' Activity 
Activity ::= '-with' Literal ( '-and' Literal )* '-do' ObjectActivity '-end' 

ObjectTypeAndArgs ::= DataStructure | AlgebraObject | GeometryObject | CombinatoricsObject | CodingTheoryObject | OtherObject
DataStructure ::= collection | set | vector | vector_ge

AlgebraObject ::= finite_field | polynomial_ring | linear_group | permutation_group | group_modification | action_on_forms | orbits | poset_classification_control | poset_classification_report_options | poset_classification_activity

GeometryObject ::= projective_space | orthogonal_space | BLT_set_classifier | spread_classifier | geometric_object | spread | cubic_surface | quartic_curve | BLT_set | translation_plane | spread_table | packing_classify | packing_was | packing_was_choose_fixed_points | packing_long_orbits | arc_generator_control | mapping | variety

CombinatoricsObject ::= graph | graph_classification | design | design_table | large_set_was | combinatorial_object | geometry_builder

CodingTheoryObject ::= code | crc_code

OtherObject ::= diophant | symbolic_object


ObjectActivity ::= AlgebraActivity | GeometryActivity | CombinatoricsActivity | CodingTheoryActivity | OtherActivity

AlgebraActivity ::= finite_field_activity | polynomial_ring_activity | group_theoretic_activity | action_on_forms_activity | orbits_activity

GeometryActivity ::= projective_space_activity | orthogonal_space_activity | cubic_surface_activity | quartic_curve_activity | blt_set_activity | variety_activity  | classification_of_cubic_surfaces_with_double_sixes_activity | spread_table_activity | packing_with_symmetry_assumption_activity | packing_fixed_points_activity | BLT_set_classify_activity | spread_classify_activity | spread_activity | translation_plane_activity 

CombinatoricsActivity ::= combinatorial_object_activity | graph_theoretic_activity | graph_classification_activity | large_set_was_activity

CodingTheoryActivity ::= coding_theoretic_activity | design_activity 

OtherActivity ::= diophant_activity | symbolic_object_activity 


