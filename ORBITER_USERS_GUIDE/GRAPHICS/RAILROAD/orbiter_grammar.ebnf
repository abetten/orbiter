Literal ::= [a-zA-Z_][0-9a-zA-Z_]*
FilePath ::= [0-9a-zA-Z_/]+
FileMask ::= [0-9a-zA-Z_/]+
Integer ::= [0-9]+
GlobalCmd ::= AlgebraGlobal | CodingTheoryGlobal | CombinatoricsGlobal | CryptographyGlobal | PovrayGlobal | ProjectiveGlobal | SymbolTableGlobal | ToolkitGlobal

Verbosity ::= ( '-v' Integer )
ListArgs ::= ( '-list_arguments' )
ParseOnly ::= ( '-parse_commands_only' )
SeedRandomGen ::= ( '-seed' Integer )
MemoryDebug ::= ( '-memory_debug' Integer )
OverridePoly ::= ( '-override_polynomial' Integer )
OrbiterPath ::= ( '-orbiter_path' FilePath )
MagmaPath ::= ( '-magma_path' FilePath )
Fork ::= ( '-fork' Literal FileMask Integer Integer Integer )
ToolkitGlobal ::= '-print_symbols'

